root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,cpp,h}]
indent_style = space
indent_size = 4

[*.{json,xml,xaml,csproj,vcxproj,props,targets,filters}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,sln}]
end_of_line = crlf
