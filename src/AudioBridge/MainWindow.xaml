<Window
    x:Class="AudioBridge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AudioBridge"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AudioBridge">

    <Grid Padding="20" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <!-- Keep rapidly changing buffer levels anchored at the left edge. -->
            <ControlTemplate x:Key="LeftAnchoredProgressBarTemplate" TargetType="ProgressBar">
                <Grid x:Name="LayoutRoot">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Determinate" />
                            <VisualState x:Name="Updating" />
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="ProgressBarRoot"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Border Clip="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClipRect}">
                            <Grid Height="{TemplateBinding MinHeight}">
                                <Rectangle x:Name="ProgressBarTrack"
                                           Fill="{TemplateBinding Background}"
                                           Height="{ThemeResource ProgressBarTrackHeight}"
                                           Width="{TemplateBinding Width}"
                                           VerticalAlignment="Center"
                                           RadiusX="{Binding Source={StaticResource ProgressBarTrackCornerRadius}, Converter={StaticResource TopLeftCornerRadiusDoubleValueConverter}}"
                                           RadiusY="{Binding Source={StaticResource ProgressBarTrackCornerRadius}, Converter={StaticResource BottomRightCornerRadiusDoubleValueConverter}}" />
                                <Rectangle x:Name="DeterminateProgressBarIndicator"
                                           Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left"
                                           RadiusX="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopLeftCornerRadiusDoubleValueConverter}}"
                                           RadiusY="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BottomRightCornerRadiusDoubleValueConverter}}" />
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="ExePathBox"
                      Grid.Row="0"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Header="Target exe"
                      MinWidth="420"
                      PlaceholderText="Select target exe"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      DropDownOpened="ExePathBox_DropDownOpened"
                      SelectionChanged="ExePathBox_SelectionChanged">
                <ComboBox.Resources>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxItemRevealBackgroundSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxItemRevealBackgroundSelectedUnfocused" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxItemRevealBackgroundSelectedPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxItemRevealBackgroundSelectedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxItemSelectedBackgroundThemeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxItemSelectedPointerOverBackgroundThemeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="Transparent" />
                </ComboBox.Resources>
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:RecentTargetView">
                        <Grid MinWidth="520" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Path}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1"
                                    Padding="8,4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Tag="{x:Bind Path}"
                                    Click="RemoveRecentTargetButton_Click"
                                    ToolTipService.ToolTip="Remove from recent targets"
                                    AutomationProperties.Name="Remove recent target">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="BrowseButton"
                    Grid.Row="0"
                    Grid.Column="3"
                    MinWidth="118"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Click="BrowseButton_Click"
                    ToolTipService.ToolTip="Browse">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    <TextBlock Text="Browse" />
                </StackPanel>
            </Button>

            <Button x:Name="OpenButton"
                    Grid.Row="0"
                    Grid.Column="4"
                    MinWidth="94"
                    VerticalAlignment="Bottom"
                    Click="OpenButton_Click"
                    ToolTipService.ToolTip="Open target">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                    <TextBlock Text="Open" />
                </StackPanel>
            </Button>
            <Button x:Name="StopButton"
                    Grid.Row="0"
                    Grid.Column="5"
                    MinWidth="94"
                    VerticalAlignment="Bottom"
                    Click="StopButton_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Stop bridge">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                    <TextBlock Text="Stop" />
                </StackPanel>
            </Button>

            <ComboBox x:Name="DeviceComboBox"
                      Grid.Row="1"
                      Grid.Column="0"
                      Header="ASIO output"
                      HorizontalAlignment="Stretch"
                      MinWidth="420"
                      DisplayMemberPath="Name"
                      SelectionChanged="DeviceComboBox_SelectionChanged" />

            <NumberBox x:Name="PrebufferBox"
                       Grid.Row="1"
                       Grid.Column="1"
                       Header="Prebuffer ms"
                       Width="180"
                       Minimum="0"
                       Maximum="10000"
                       SmallChange="50"
                       LargeChange="100"
                       Value="300"
                       SpinButtonPlacementMode="Inline"
                       ValueChanged="PrebufferBox_ValueChanged" />

            <NumberBox x:Name="AsioBufferBox"
                       Grid.Row="1"
                       Grid.Column="3"
                       Header="ASIO buffer frames"
                       Width="180"
                       Minimum="0"
                       Maximum="8192"
                       SmallChange="64"
                       LargeChange="512"
                       Value="0"
                       SpinButtonPlacementMode="Inline"
                       ValueChanged="AsioBufferBox_ValueChanged" />

            <NumberBox x:Name="MaxBufferAdvanceBox"
                       Grid.Row="1"
                       Grid.Column="2"
                       Header="Max buffer advance ms"
                       Width="180"
                       Minimum="50"
                       Maximum="10000"
                       SmallChange="10"
                       LargeChange="100"
                       Value="100"
                       SpinButtonPlacementMode="Inline"
                       ValueChanged="MaxBufferAdvanceBox_ValueChanged"
                       ToolTipService.ToolTip="When buffered audio falls below Prebuffer minus this value, AudioBridge pads the queue with silence to restore the configured Prebuffer." />

            <CheckBox x:Name="FakeOutputCheckBox"
                      Grid.Row="1"
                      Grid.Column="4"
                      Grid.ColumnSpan="2"
                      Content="Fake Output"
                      IsChecked="True"
                      VerticalAlignment="Bottom"
                      ToolTipService.ToolTip="Route the target into the bridge without opening the app's real shared output." />

            <ComboBox x:Name="ClockSourceComboBox"
                      Grid.Row="2"
                      Grid.Column="0"
                      Header="ASIO clock source"
                      HorizontalAlignment="Stretch"
                      MinWidth="420"
                      DisplayMemberPath="Name"
                      IsEnabled="False"
                      PlaceholderText="Driver clock sources unavailable"
                      SelectionChanged="ClockSourceComboBox_SelectionChanged"
                      ToolTipService.ToolTip="Select a driver-reported clock source before opening the target. AudioBridge verifies the source during ASIO initialization." />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Audio PIDs" FontSize="16" FontWeight="SemiBold" />
                <ListView x:Name="PidListView"
                          Grid.Row="1"
                          SelectionChanged="PidListView_SelectionChanged"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:AudioPidView">
                            <Grid Padding="6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Pid}" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Format, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind LastPcm, Mode=OneWay}" FontSize="12" Opacity="0.72" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind SelectedText, Mode=OneWay}"
                                           HorizontalAlignment="Right"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Status" FontSize="16" FontWeight="SemiBold" />

                <Grid Grid.Row="1" ColumnSpacing="20" RowSpacing="10" Margin="0,2,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Target PID" Opacity="0.72" />
                    <TextBlock x:Name="TargetPidText" Grid.Column="1" Text="-" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Selected PID" Opacity="0.72" />
                    <TextBlock x:Name="SelectedPidText" Grid.Column="3" Text="-" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="State" Opacity="0.72" />
                    <TextBlock x:Name="BridgeStateText" Grid.Column="5" Text="Idle" FontWeight="SemiBold" />

                    <TextBlock Grid.Row="1" Text="Buffered" Opacity="0.72" />
                    <TextBlock x:Name="BufferedText" Grid.Row="1" Grid.Column="1" Text="0 ms" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Capacity" Opacity="0.72" />
                    <TextBlock x:Name="CapacityText" Grid.Row="1" Grid.Column="3" Text="0 ms" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Silent Last Minute" Opacity="0.72" />
                    <TextBlock x:Name="SilentPercentText" Grid.Row="1" Grid.Column="5" Text="0.00%" FontWeight="SemiBold" />

                    <TextBlock Grid.Row="2" Text="Underruns" Opacity="0.72" />
                    <TextBlock x:Name="UnderrunText" Grid.Row="2" Grid.Column="1" Text="0" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="ASIO Clock" Opacity="0.72" />
                    <TextBlock x:Name="AsioClockText"
                               Grid.Row="2"
                               Grid.Column="3"
                               Text="-"
                               TextTrimming="CharacterEllipsis"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="Queued / Played" Opacity="0.72" />
                    <TextBlock x:Name="FramesText" Grid.Row="2" Grid.Column="5" Text="0 / 0" FontWeight="SemiBold" />

                    <TextBlock Grid.Row="3" Text="Buffer Fill" Opacity="0.72" />
                    <ProgressBar x:Name="BufferProgress"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Template="{StaticResource LeftAnchoredProgressBarTemplate}"
                                 Height="8"
                                 VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="4" Text="Silent %" Opacity="0.72" />
                    <ProgressBar x:Name="SilentProgress"
                                  Grid.Row="3"
                                  Grid.Column="5"
                                  Minimum="0"
                                  Maximum="100"
                                  Value="0"
                                  Height="8"
                                  VerticalAlignment="Center" />

                    <TextBlock Grid.Row="4" Text="ASIO Buffer" Opacity="0.72" />
                    <TextBlock x:Name="AsioBufferText" Grid.Row="4" Grid.Column="1" Text="-" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="ASIO Preferred" Opacity="0.72" />
                    <TextBlock x:Name="AsioPreferredText" Grid.Row="4" Grid.Column="3" Text="-" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="4" Grid.Column="4" Text="ASIO Sample" Opacity="0.72" />
                    <TextBlock x:Name="AsioSampleText" Grid.Row="4" Grid.Column="5" Text="-" FontWeight="SemiBold" />

                    <TextBlock Grid.Row="5" Text="ASIO Range" Opacity="0.72" />
                    <TextBlock x:Name="AsioRangeText" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="-" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="5" Grid.Column="4" Text="ASIO Events" Opacity="0.72" />
                    <TextBlock x:Name="AsioEventsText" Grid.Row="5" Grid.Column="5" Text="-" FontWeight="SemiBold" />
                </Grid>

                <TextBlock x:Name="LastErrorText"
                           Grid.Row="2"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Opacity="0.78" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Debug Log" FontSize="16" FontWeight="SemiBold" />
            <TextBox x:Name="LogBox"
                     Grid.Row="1"
                     FontFamily="Consolas"
                     FontSize="12"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</Window>
